<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.westoncodeops.sample.controllers.AddTicketModalController"
      spacing="20" styleClass="modal-content" prefWidth="600" prefHeight="550">
    
    <!-- Modal Header -->
    <VBox spacing="5">
        <Label text="Create Maintenance Ticket" styleClass="modal-title"/>
        <Label text="Fill in the ticket information below" styleClass="section-subtitle"/>
    </VBox>
    
    <!-- Form Fields -->
    <GridPane hgap="15" vgap="15" VBox.vgrow="ALWAYS">
        <!-- Title -->
        <Label text="Issue Title:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="titleField" promptText="Brief description of the issue"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250"/>
        
        <!-- Category -->
        <Label text="Category:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="categoryComboBox" promptText="Select category"
                  GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250"/>
        
        <!-- Tenant Phone -->
        <Label text="Tenant Phone:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="phoneField" promptText="Tenant's phone number"
                   GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="250"/>
        
        <!-- Description -->
        <Label text="Description:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="3" VBox.vgrow="ALWAYS"/>
        <TextArea fx:id="descriptionField" promptText="Describe the issue in detail"
                  GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="250" prefHeight="120" wrapText="true"/>
    </GridPane>
    
    <!-- Status Message -->
    <Label fx:id="statusLabel" text="" styleClass="label-small" wrapText="true"/>
    
    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="button-secondary" onAction="#closeModal" prefWidth="120"/>
        <Button fx:id="saveButton" text="Create Ticket" styleClass="button-primary"
                onAction="#saveTicket" prefWidth="120"/>
    </HBox>
    
</VBox>
