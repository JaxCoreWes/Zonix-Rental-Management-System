<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.westoncodeops.sample.controllers.AddUnitModalController"
      spacing="20" styleClass="modal-content" prefWidth="600" prefHeight="500">
    
    <!-- Modal Header -->
    <VBox spacing="5">
        <Label text="Add New Unit" styleClass="modal-title"/>
        <Label text="Fill in the unit information below" styleClass="section-subtitle"/>
    </VBox>
    
    <!-- Form Fields -->
    <GridPane hgap="15" vgap="15" VBox.vgrow="ALWAYS">
        <!-- Unit Number -->
        <Label text="Unit Number:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="unitNumberField" promptText="e.g., A101"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250"/>
        
        <!-- Floor -->
        <Label text="Floor:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="floorField" promptText="e.g., 1"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250"/>
        
        <!-- Rent Amount -->
        <Label text="Rent Amount (KES):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="rentAmountField" promptText="e.g., 25000"
                   GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="250"/>
    </GridPane>
    
    <!-- Status Message -->
    <Label fx:id="statusLabel" text="" styleClass="label-small" wrapText="true"/>
    
    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="button-secondary" onAction="#closeModal" prefWidth="120"/>
        <Button fx:id="saveButton" text="Save Unit" styleClass="button-primary"
                onAction="#saveUnit" prefWidth="120"/>
    </HBox>
    
</VBox>
